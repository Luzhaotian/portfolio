{
  "name": "luzhaotian-portfolio",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "build": "next build",
    "preview": "GITHUB_PAGES=true npm run build && npx --yes serve out -p 3000",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs,.cjs --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs,.cjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf .next",
    "fetch:blogs": "node scripts/fetch-csdn-blogs.mjs && prettier --write data/blogs.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "card-orbit": "^0.1.2",
    "next": "^15.3.3",
    "p5": "^1.11.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.170.0",
    "three-vanta": "npm:three@^0.151.3",
    "vanta": "^0.5.24"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^22.15.21",
    "@types/p5": "^1.7.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/three": "^0.170.0",
    "@unocss/postcss": "^66.7.2",
    "@unocss/preset-wind3": "^66.7.2",
    "@unocss/reset": "^66.7.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.19",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.4",
    "prettier": "^3.8.4",
    "typescript": "^5.8.3",
    "unocss": "^66.7.2"
  }
}
