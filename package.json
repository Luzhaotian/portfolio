{
  "name": "luzhaotian-portfolio",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/next/dist/bin/next dev",
    "dev:clean": "npm run clean && node --env-file=.env ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "preview": "GITHUB_PAGES=true npm run build && npx --yes serve out -p 3000",
    "start": "node --env-file=.env ./node_modules/next/dist/bin/next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs,.cjs --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs,.cjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "clean": "rm -rf .next",
    "fetch:blogs": "node scripts/fetch-csdn-blogs.mjs && prettier --write data/blogs.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fxshelf/card-orbit": "^0.1.8",
    "@fxshelf/swarm-cursors": "^0.1.1",
    "next": "^15.5.29",
    "p5": "^1.11.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.170.0",
    "three-vanta": "npm:three@^0.151.3",
    "vanta": "^0.5.24"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/p5": "^1.7.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "@unocss/postcss": "^66.13.0",
    "@unocss/preset-wind3": "^66.13.0",
    "@unocss/reset": "^66.13.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "unocss": "^66.13.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
